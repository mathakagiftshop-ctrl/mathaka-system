# Postgres (Neon). Use the "-pooler" host so serverless functions share connections.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Only this email can create the first (owner) account on /login.
MATHAKA_OWNER_EMAIL=you@example.com

# Public site address used in links sent on WhatsApp, e.g. https://studio.mathaka.lk
# Optional: without it the app uses the address the request came in on.
APP_URL=

# S3-compatible storage for the logo, payment slips and delivery photos.
# (S3_* names because Vercel reserves AWS_*; AWS_* also works locally.)
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=assets

# Meta ads spend sync (Expenses → "Sync now", and daily at 6:00 Sri Lanka time).
# Token: a System User token with ads_read, from Meta Business Settings.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=1061913142808605
# First day to sync; September is entered by hand.
META_ADS_SINCE=2026-10-01
# Any long random string; Vercel sends it to the cron route.
CRON_SECRET=
